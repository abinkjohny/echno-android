<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and older. The session is excluded: its tokens are encrypted with a
     device-only Keystore key, so a restored copy can't be decrypted, and sessions shouldn't move
     between devices. -->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>
