<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer on Android 12+. Same rule as backup_rules.xml: never copy
     the session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
