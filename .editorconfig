root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,yml,yaml,json}]
indent_size = 4
